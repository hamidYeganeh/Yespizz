{
  "name": "yespiz",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "demo": "npm run build -w api && node scripts/demo.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "android:run": "npm run android:run --workspace application",
    "android:apk": "node \"%npm_execpath%\" run android:apk --workspace application",
    "android:aab": "node \"%npm_execpath%\" run android:aab --workspace application"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1"
  }
}
